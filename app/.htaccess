RewriteEngine On

# Politica zero cache: nenhum navegador armazena o sistema do cartao
<IfModule mod_headers.c>
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
</IfModule>

RewriteRule ^admin/?$ admin_login.php [L]

# /usuario sempre abre a versão web (painel)
RewriteRule ^usuario/?$ web/login.php [L]

# /web abre o login da versão web
RewriteRule ^web/?$ web/login.php [L]

<FilesMatch "\.log$">
Require all denied
</FilesMatch>

# Credencial da conta de serviço do Firebase (push) — nunca acessível pela web.
# Prefira mantê-la FORA do webroot e apontar FCM_CREDENTIALS_FILE para ela.
<FilesMatch "^fcm_service_account\.json$">
Require all denied
</FilesMatch>
